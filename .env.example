# Required: YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=
# Optional: enables the LLM-written report / Q&A. Without it a deterministic template report is used.
ANTHROPIC_API_KEY=
# Full reports vs. quick questions use different models (defaults shown):
# ANTHROPIC_MODEL_REPORT=claude-sonnet-5-5
# ANTHROPIC_MODEL_QUESTION=claude-haiku-4-5-20251001
# The Reach > Deep dive write-up (reads thumbnails too). Defaults to ANTHROPIC_MODEL_REPORT:
# ANTHROPIC_MODEL_DEEPDIVE=claude-sonnet-5-5

# Optional (V2): enables "Connect Analytics" for your OWN channel. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client:
# OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Key that encrypts stored OAuth tokens. Leave blank to auto-generate data/secret.key
# APP_SECRET_KEY=
# CACHE_HOURS=6
